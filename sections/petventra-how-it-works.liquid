{{ 'petventra-how-it-works.css' | asset_url | stylesheet_tag }}

<div class="petventra-how page-width">
  <div class="petventra-how__header">
    {% if section.settings.heading != blank %}
      <h2 class="petventra-how__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.intro != blank %}
      <div class="petventra-how__intro">{{ section.settings.intro }}</div>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <ol class="petventra-how__steps">
      {% for block in section.blocks %}
        <li class="petventra-how__step" {{ block.shopify_attributes }}>
          <span class="petventra-how__step-number">{{ forloop.index }}</span>
          <div class="petventra-how__step-content">
            {% if block.settings.title != blank %}
              <h3 class="petventra-how__step-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="petventra-how__step-text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</div>

{% schema %}
{
  "name": "Petventra How It Works",
  "tag": "section",
  "class": "petventra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Como funciona"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Configurar a coleira Petventra demora menos de 5 minutos.</p>"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Coloca a coleira"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Ajusta a coleira ao tamanho do teu cão em segundos."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petventra How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": { "title": "Coloca a coleira", "text": "Ajusta a coleira ao tamanho do teu cão em segundos." }
        },
        {
          "type": "step",
          "settings": { "title": "Liga à app gratuita", "text": "Associa o dispositivo por Bluetooth em menos de 2 minutos." }
        },
        {
          "type": "step",
          "settings": { "title": "Acompanha em tempo real", "text": "Vê a localização exata do teu cão a qualquer momento, em qualquer lugar." }
        }
      ]
    }
  ]
}
{% endschema %}
