{{ 'petventra-app-showcase.css' | asset_url | stylesheet_tag }}

<div class="petventra-app page-width">
  <div class="petventra-app__container">
    <div class="petventra-app__media">
      {% if section.settings.image_url != blank %}
        <img
          src="{{ section.settings.image_url }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          class="petventra-app__image"
          width="1200"
          height="1200"
        >
      {% elsif section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 45vw, 100vw', widths: '400,600,800,1000,1200', class: 'petventra-app__image'
        }}
      {% else %}
        <img
          src="{{ 'petventra-app-showcase.jpg' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          class="petventra-app__image"
          width="1200"
          height="675"
        >
      {% endif %}
    </div>

    <div class="petventra-app__content">
      {% if section.settings.heading != blank %}
        <h2 class="petventra-app__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <div class="petventra-app__intro">{{ section.settings.intro }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <ul class="petventra-app__features" role="list">
          {% for block in section.blocks %}
            <li class="petventra-app__feature" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="petventra-app__feature-icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {% endif %}
              <div>
                {% if block.settings.title != blank %}
                  <span class="petventra-app__feature-title">{{ block.settings.title }}</span>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="petventra-app__feature-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Petventra App Showcase",
  "tag": "section",
  "class": "petventra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tudo no teu bolso"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>A app Petventra dá-te controlo total sobre a localização e segurança do teu cão, de forma simples e intuitiva.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (Shopify CDN — overrides Image above)"
    }
  ],
  "blocks": [
    {
      "type": "app_feature",
      "name": "App feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "📍"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Localização em tempo real"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Vê onde está o teu cão, atualizado ao segundo."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petventra App Showcase",
      "blocks": [
        { "type": "app_feature", "settings": { "icon": "📍", "title": "Localização em tempo real", "text": "Vê onde está o teu cão, atualizado ao segundo." } },
        { "type": "app_feature", "settings": { "icon": "🚧", "title": "Alertas de zona segura", "text": "Recebe uma notificação assim que o teu cão sai da área definida." } },
        { "type": "app_feature", "settings": { "icon": "🕓", "title": "Histórico de percursos", "text": "Consulta todos os passeios e locais visitados." } },
        { "type": "app_feature", "settings": { "icon": "🔋", "title": "Estado da bateria", "text": "Acompanha o nível de bateria da coleira em tempo real." } }
      ]
    }
  ]
}
{% endschema %}
