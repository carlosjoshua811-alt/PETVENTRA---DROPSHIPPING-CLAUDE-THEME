{{ 'petventra-comparison.css' | asset_url | stylesheet_tag }}

<div class="petventra-comparison page-width">
  {% if section.settings.heading != blank %}
    <h2 class="petventra-comparison__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.intro != blank %}
    <div class="petventra-comparison__intro">{{ section.settings.intro }}</div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="petventra-comparison__table-wrapper">
      <table class="petventra-comparison__table">
        <thead>
          <tr>
            <th class="petventra-comparison__th petventra-comparison__th--feature"></th>
            <th class="petventra-comparison__th petventra-comparison__th--petventra">
              {{ section.settings.petventra_label | default: 'Petventra' }}
            </th>
            <th class="petventra-comparison__th">
              {{ section.settings.competitor_a_label | default: 'Traditional Shock Collar' }}
            </th>
            <th class="petventra-comparison__th">
              {{ section.settings.competitor_b_label | default: 'Ultrasonic Devices' }}
            </th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <td class="petventra-comparison__td petventra-comparison__td--feature">{{ block.settings.feature }}</td>
              <td class="petventra-comparison__td petventra-comparison__td--petventra">
                {% if block.settings.petventra_value %}
                  <span class="petventra-comparison__icon petventra-comparison__icon--yes" aria-label="Yes">✓</span>
                {% else %}
                  <span class="petventra-comparison__icon petventra-comparison__icon--no" aria-label="No">✕</span>
                {% endif %}
              </td>
              <td class="petventra-comparison__td">
                {% if block.settings.competitor_a_value %}
                  <span class="petventra-comparison__icon petventra-comparison__icon--yes" aria-label="Yes">✓</span>
                {% else %}
                  <span class="petventra-comparison__icon petventra-comparison__icon--no" aria-label="No">✕</span>
                {% endif %}
              </td>
              <td class="petventra-comparison__td">
                {% if block.settings.competitor_b_value %}
                  <span class="petventra-comparison__icon petventra-comparison__icon--yes" aria-label="Yes">✓</span>
                {% else %}
                  <span class="petventra-comparison__icon petventra-comparison__icon--no" aria-label="No">✕</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Petventra Comparison",
  "tag": "section",
  "class": "petventra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Petventra"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>See how Petventra compares to traditional bark correction methods.</p>"
    },
    {
      "type": "text",
      "id": "petventra_label",
      "label": "Petventra column label",
      "default": "Petventra"
    },
    {
      "type": "text",
      "id": "competitor_a_label",
      "label": "Competitor A column label",
      "default": "Traditional Shock Collar"
    },
    {
      "type": "text",
      "id": "competitor_b_label",
      "label": "Competitor B column label",
      "default": "Ultrasonic Devices"
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Adjustable Sensitivity"
        },
        {
          "type": "checkbox",
          "id": "petventra_value",
          "label": "Petventra has this",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "competitor_a_value",
          "label": "Competitor A has this",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "competitor_b_value",
          "label": "Competitor B has this",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petventra Comparison",
      "blocks": [
        { "type": "comparison_row", "settings": { "feature": "Adjustable Sensitivity (8 Levels)", "petventra_value": true, "competitor_a_value": false, "competitor_b_value": false } },
        { "type": "comparison_row", "settings": { "feature": "Safety Auto-Stop", "petventra_value": true, "competitor_a_value": false, "competitor_b_value": false } },
        { "type": "comparison_row", "settings": { "feature": "3 Correction Modes (Beep / Vibration / Static)", "petventra_value": true, "competitor_a_value": false, "competitor_b_value": false } },
        { "type": "comparison_row", "settings": { "feature": "IP67 Waterproof", "petventra_value": true, "competitor_a_value": false, "competitor_b_value": false } },
        { "type": "comparison_row", "settings": { "feature": "Color LCD Display", "petventra_value": true, "competitor_a_value": false, "competitor_b_value": false } },
        { "type": "comparison_row", "settings": { "feature": "Humane, Gradual Training", "petventra_value": true, "competitor_a_value": false, "competitor_b_value": false } }
      ]
    }
  ]
}
{% endschema %}
