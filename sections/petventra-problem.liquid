{{ 'petventra-problem.css' | asset_url | stylesheet_tag }}

<div class="petventra-problem page-width">
  <div class="petventra-problem__header">
    {% if section.settings.heading != blank %}
      <h2 class="petventra-problem__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.intro != blank %}
      <div class="petventra-problem__intro">{{ section.settings.intro }}</div>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="petventra-problem__grid">
      {% for block in section.blocks %}
        <div class="petventra-problem__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <span class="petventra-problem__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          {% endif %}
          {% if block.settings.title != blank %}
            <h3 class="petventra-problem__item-title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="petventra-problem__item-text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Petventra Problem",
  "tag": "section",
  "class": "petventra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quantas vezes já entraste em pânico?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Um cão que foge não avisa. Estes são os momentos que todo o dono teme.</p>"
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "😰"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "O portão ficou aberto"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "E o teu cão desapareceu antes de dares por isso."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petventra Problem",
      "blocks": [
        {
          "type": "problem",
          "settings": { "icon": "🚪", "title": "O portão ficou aberto", "text": "E o teu cão desapareceu antes de dares por isso." }
        },
        {
          "type": "problem",
          "settings": { "icon": "🎆", "title": "Fogo de artifício assustou-o", "text": "Ele fugiu em pânico e não sabes para onde foi." }
        },
        {
          "type": "problem",
          "settings": { "icon": "🌳", "title": "Perdeu-se na caminhada", "text": "Afastou-se do trilho e já não vês a coleira ao longe." }
        }
      ]
    }
  ]
}
{% endschema %}
