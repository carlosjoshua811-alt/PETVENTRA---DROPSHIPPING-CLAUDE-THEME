{{ 'petventra-specs.css' | asset_url | stylesheet_tag }}

<div class="petventra-specs page-width">
  <div class="petventra-specs__container">
    <div class="petventra-specs__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 45vw, 100vw', widths: '400,600,800,1000,1200', class: 'petventra-specs__image'
        }}
      {% else %}
        <div class="petventra-specs__image-placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'petventra-specs__placeholder' }}
        </div>
      {% endif %}
    </div>

    <div class="petventra-specs__content">
      {% if section.settings.heading != blank %}
        <h2 class="petventra-specs__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <div class="petventra-specs__intro">{{ section.settings.intro }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <dl class="petventra-specs__list">
          {% for block in section.blocks %}
            <div class="petventra-specs__row" {{ block.shopify_attributes }}>
              <dt class="petventra-specs__label">{{ block.settings.label }}</dt>
              <dd class="petventra-specs__value">{{ block.settings.value }}</dd>
            </div>
          {% endfor %}
        </dl>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Petventra Specs",
  "tag": "section",
  "class": "petventra-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feito para aventuras reais"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Especificações técnicas pensadas para qualquer raça e qualquer clima.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bateria"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Até 15 dias de autonomia"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petventra Specs",
      "blocks": [
        { "type": "spec", "settings": { "label": "Bateria", "value": "Até 15 dias de autonomia" } },
        { "type": "spec", "settings": { "label": "Resistência", "value": "IP67 à prova de água e poeira" } },
        { "type": "spec", "settings": { "label": "Alcance GPS", "value": "Cobertura ilimitada via rede móvel" } },
        { "type": "spec", "settings": { "label": "Peso", "value": "32g — confortável para todas as raças" } },
        { "type": "spec", "settings": { "label": "Conectividade", "value": "GPS + LBS + Bluetooth" } },
        { "type": "spec", "settings": { "label": "App", "value": "iOS e Android, grátis para sempre" } }
      ]
    }
  ]
}
{% endschema %}
