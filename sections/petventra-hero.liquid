{{ 'petventra-hero.css' | asset_url | stylesheet_tag }}

<div class="petventra-hero" style="--petventra-hero-bg: {{ section.settings.background_color }};">
  <div class="petventra-hero__container page-width">
    <div class="petventra-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="petventra-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="petventra-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="petventra-hero__description">{{ section.settings.description }}</div>
      {% endif %}

      <div class="petventra-hero__actions">
        {% if section.settings.cta_label != blank %}
          <a
            href="{{ section.settings.cta_link | default: '#' }}"
            class="petventra-hero__cta"
          >
            {{ section.settings.cta_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_text != blank %}
          <p class="petventra-hero__secondary-text">{{ section.settings.secondary_text }}</p>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <ul class="petventra-hero__badges" role="list">
          {% for block in section.blocks %}
            <li class="petventra-hero__badge" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="petventra-hero__badge-icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {% endif %}
              <span>{{ block.settings.label }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="petventra-hero__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '400,600,800,1000,1200,1600',
            class: 'petventra-hero__image'
        }}
      {% else %}
        <img
          src="{{ 'petventra-hero.jpg' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
          class="petventra-hero__image"
          width="1600"
          height="2400"
        >
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Petventra Hero",
  "tag": "section",
  "class": "petventra-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "GPS Tracker Collar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nunca mais percas o teu cão de vista"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Localização em tempo real, alertas instantâneos e bateria que dura semanas. Dá ao teu melhor amigo a liberdade que ele merece, com a segurança que tu precisas.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Comprar agora"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary text",
      "default": "Envio grátis · Garantia de 30 dias"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f6f4"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✅"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "GPS em tempo real"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petventra Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "📍", "label": "GPS em tempo real" } },
        { "type": "badge", "settings": { "icon": "🔋", "label": "Bateria até 15 dias" } },
        { "type": "badge", "settings": { "icon": "💧", "label": "Resistente à água" } }
      ]
    }
  ]
}
{% endschema %}
